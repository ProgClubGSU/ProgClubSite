---
// Background marquee — full approved pool of wide event/crowd photos.
// Every "progsu" word cycles to the next image, so no two adjacent words match.
// Each row starts at a different offset into the pool (and alternates scroll
// direction) so rows don't visually line up with each other either.
const POOL = [
  "/hero/1.png",
  "/hero/2.png",
  "/hero/3.png",
  "/hero/4.png",
  "/hero/5.png",
  "/hero/6.png",
  "/hero/7.png",
  "/hero/8.png",
  "/hero/9.png",
  "/hero/10.png",
  "/hero/11.png",
  "/images/landing%20page/hacklanta.jpg",
  "/images/landing%20page/progirls.jpg",
  "/images/landing%20page/meet%20the%20team.jpg",
  "/images/landing%20page/our%20mission.jpg",
  "/images/progirls/8V4A9282.jpg",
  "/images/progirls/8V4A9332.jpg",
  "/images/progirls/8V4A9339.jpg",
  "/images/progirls/8V4A9396%20(1).jpg",
];

const ROWS = [
  { direction: "left" },
  { direction: "right" },
  { direction: "left" },
  { direction: "right" },
];

const REPEATS = 8; // "progsu" repeated per copy, doubled in markup for the seamless loop
const ROW_OFFSET_STEP = 3; // stagger each row's starting point in the pool
---

<section
  id="hero"
  class="relative w-full min-h-screen bg-black overflow-hidden flex items-center justify-center"
>
  <!-- Background: rows of image-filled "progsu" text, scrolling on an infinite loop -->
  <div class="absolute inset-0 flex flex-col justify-center overflow-hidden select-none pointer-events-none" aria-hidden="true">
    {ROWS.map((row, rowIndex) => (
      <div class:list={["marquee-row", row.direction === "left" ? "marquee-left" : "marquee-right"]}>
        <div class="marquee-track">
          {[0, 1].map(() => (
            Array.from({ length: REPEATS }).map((_, w) => {
              const img = POOL[(w + rowIndex * ROW_OFFSET_STEP) % POOL.length];
              return <span class="marquee-word" style={`background-image: url('${img}');`}>progsu</span>;
            })
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Foreground: real wordmark, tagline, CTA -->
  <div class="relative z-10 flex flex-col items-center text-center px-4 pointer-events-none">
    <h1 class="hero-wordmark text-white">progsu</h1>
    <p class="hero-tagline text-white/70 mt-3 md:mt-4">
      builders &amp; dreamers of atl. a new generation of talent.
    </p>
    <div class="mt-8 md:mt-10 pointer-events-auto">
      <a
        href="https://members.progsu.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-cta"
      >
        join our community
      </a>
    </div>
  </div>
</section>

<style>
  .hero-wordmark {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 15vw, 8rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-tagline {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-style: italic;
    font-size: clamp(0.85rem, 2.2vw, 1.15rem);
    max-width: 32rem;
  }

  .hero-cta {
    display: inline-block;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(0.85rem, 2vw, 1rem);
    color: #000;
    background: #fff;
    padding: 0.85em 2em;
    border-radius: 999px;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: transform 200ms ease, background-color 200ms ease, color 200ms ease;
  }

  .hero-cta:hover {
    background: #571294;
    color: #fff;
    transform: translateY(-2px);
  }

  .hero-cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .hero-cta:active {
    background: #571294;
    color: #fff;
    transform: translateY(0);
    opacity: 0.85;
  }

  /* ---------- background marquee ---------- */
  .marquee-row {
    --marquee-duration: 60s;
    width: 100%;
    overflow: hidden;
    line-height: 1.2;
    padding-bottom: 0.1em;
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .marquee-word {
    display: inline-block;
    white-space: nowrap;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3.75rem, 18.75vw, 10rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-right: 0.2em;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    opacity: 0.22;
  }

  .marquee-left .marquee-track {
    animation: marquee-scroll-left var(--marquee-duration) linear infinite;
  }

  .marquee-right .marquee-track {
    animation: marquee-scroll-right var(--marquee-duration) linear infinite;
  }

  @keyframes marquee-scroll-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @keyframes marquee-scroll-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  /* Fewer rows on small screens so it doesn't overwhelm the wordmark */
  .marquee-row:nth-child(3),
  .marquee-row:nth-child(4) {
    display: none;
  }
  @media (min-width: 640px) {
    .marquee-row:nth-child(3) {
      display: block;
    }
  }
  @media (min-width: 1024px) {
    .marquee-row:nth-child(4) {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-left .marquee-track,
    .marquee-right .marquee-track {
      animation-play-state: paused;
    }
  }
</style>
