---
import "@/styles/footer.css";
---

<footer class="footer" id="site-footer">
  <p class="footer-copyright" id="footer-copyright">&copy; 2026</p>
  <p class="footer-wordmark" id="footer-wordmark">progsu</p>
</footer>

<script>
  let cleanupFooterReveal: (() => void) | null = null;

  function initFooterReveal() {
    if (cleanupFooterReveal) {
      cleanupFooterReveal();
      cleanupFooterReveal = null;
    }

    const footer = document.getElementById('site-footer');
    const content = document.querySelector<HTMLElement>('.content');
    const copyright = document.getElementById('footer-copyright');
    const wordmark = document.getElementById('footer-wordmark');
    if (!footer || !content || !copyright || !wordmark) return;

    // The CSS font-size (25vw) is just a starting point. Reset to it, measure
    // the rendered width against the footer's actual width, then scale the
    // font-size by that exact ratio — font metrics scale linearly with
    // font-size, so one measure-and-correct pass lands on an exact
    // edge-to-edge fit regardless of which Helvetica Neue fallback the OS
    // renders. Note: .footer-wordmark must NOT have a CSS width set, or
    // getBoundingClientRect() would report the container's width instead of
    // the text's actual rendered width, making this measurement a no-op.
    const fitWordmark = () => {
      wordmark.style.fontSize = '25vw';
      const targetWidth = footer.clientWidth;
      const referenceWidth = wordmark.getBoundingClientRect().width;
      const referenceFontSizePx = parseFloat(getComputedStyle(wordmark).fontSize);
      if (referenceWidth > 0 && referenceFontSizePx > 0) {
        wordmark.style.fontSize = `${referenceFontSizePx * (targetWidth / referenceWidth)}px`;
      }
    };

    fitWordmark();
    window.addEventListener('resize', fitWordmark);

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let ticking = false;
    let onScroll: (() => void) | null = null;

    if (!prefersReducedMotion) {
      const update = () => {
        ticking = false;
        const footerHeight = footer.getBoundingClientRect().height || 1;
        const vh = window.innerHeight || 1;
        // The footer is position:fixed, so its own rect never moves — track
        // .content's bottom edge instead. It starts at/below the viewport
        // bottom (footer fully hidden). If the footer is shorter than the
        // viewport, the page can't scroll .content's bottom all the way to
        // 0 — it bottoms out at (vh - footerHeight) once nothing is left to
        // scroll, and that's what "fully revealed" actually looks like.
        const minContentBottom = Math.max(0, vh - footerHeight);
        const contentBottom = content.getBoundingClientRect().bottom;
        const progress = Math.min(1, Math.max(0, 1 - (contentBottom - minContentBottom) / footerHeight));

        const opacity = (0.4 + 0.6 * progress).toFixed(3);
        const translateY = (24 * (1 - progress)).toFixed(2);
        const transform = `translateY(${translateY}px)`;

        copyright.style.opacity = opacity;
        copyright.style.transform = transform;
        wordmark.style.opacity = opacity;
        wordmark.style.transform = transform;
      };

      onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }

    cleanupFooterReveal = () => {
      window.removeEventListener('resize', fitWordmark);
      if (onScroll) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterReveal);
  } else {
    initFooterReveal();
  }
  document.addEventListener('astro:page-load', initFooterReveal);
</script>
