---
import { getEvents, renderPortableText } from "@/lib/sanity.js";
import Hero from "@/components/Hero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Section from "@/components/Section.astro";
import ImageCard from "@/components/ImageCard.astro";
import BlogPostCard from "@/components/BlogPostCard.astro";
import Layout from "@/layouts/Layout.astro";
import { KNOWN_TECH, ABOUT_ME, SITE_TITLE, DISCORD_LINK, SOCIAL_LINKS, INSTAGRAM_LINK, LINKEDIN_LINK, EMAIL_LINK } from "@/consts";
import { separateEventsByDisplayType, sortEventsByPriority, type Event } from "@/utils/eventUtils";

const rawEvents = await getEvents();

// aHelper function to extract plain text from description
function getPlainTextExcerpt(description) {
  if (typeof description === 'string') return description;
  if (!description || !Array.isArray(description)) return '';
  
  // Extract text from block content
  return description
    .filter(block => block._type === 'block')
    .map(block => 
      block.children
        ?.filter(child => child._type === 'span')
        ?.map(span => span.text)
        ?.join('') || ''
    )
    .join(' ')
    .substring(0, 150) + '...';
}

// Helper function to determine event status
function getEventStatus(date) {
  if (!date) return 'upcoming';
  
  const now = new Date();
  const eventDate = new Date(date);
  
  // Set event date to start of day for comparison
  eventDate.setHours(0, 0, 0, 0);
  const today = new Date(now);
  today.setHours(0, 0, 0, 0);
  
  if (eventDate < today) return 'past';
  if (eventDate.getTime() === today.getTime()) return 'active';
  return 'upcoming';
}

// Convert raw events to Event type and sort by priority
const events: Event[] = rawEvents.map(event => ({
  ...event,
  slug: { current: event.slug.current }
}));

const sortedEvents = sortEventsByPriority(events);

// Get only featured and upcoming events (no past events)
const { fullCardEvents, liteCardEvents } = separateEventsByDisplayType(sortedEvents);

// Combine and limit to 3 events for home page (more minimal)
const homePageEvents = [...fullCardEvents, ...liteCardEvents].slice(0, 3);
---

<Layout title={SITE_TITLE}>
  <div id="top"></div>
  <Hero />
  
  <!-- Movements Section -->
  <section id="movements" class="py-16 px-8 bg-black relative overflow-hidden">
    <div class="max-w-5xl mx-auto relative z-10 float-in">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 tracking-widest text-center italic" style="font-family: 'Helvetica Neue', sans-serif;">
        movements
      </h2>

      <div class="flex md:grid md:grid-cols-3 gap-6 md:gap-8 overflow-x-auto snap-x snap-mandatory md:overflow-visible md:snap-none pb-4 md:pb-0 -mx-8 px-8 md:mx-0 md:px-0">
        <div class="w-[82%] sm:w-[60%] md:w-auto flex-shrink-0 md:flex-shrink snap-center md:snap-align-none">
          <ImageCard
            title="hacklanta"
            description="our flagship hackathon. where builders come to break things, chase ideas, and create something from nothing. atlanta's proving ground for what's next."
            ctaText="learn more"
            ctaHref="https://hacklanta.dev"
            external={true}
            imageSrc="/images/landing%20page/hacklanta.jpg"
            imageAlt="students collaborating at the hacklanta hackathon"
          />
        </div>

        <div class="w-[82%] sm:w-[60%] md:w-auto flex-shrink-0 md:flex-shrink snap-center md:snap-align-none">
          <ImageCard
            title="gitpaid"
            description="everything we know about landing the job, from resume to offer letter. built by the people who've done it."
            ctaText="learn more"
            ctaHref="/gitpaid"
            imageSrc="/images/landing%20page/gitpaid.jpg"
            imageAlt="a resume and laptop on a desk, representing the gitpaid job-hunting guide"
          />
        </div>

        <div class="w-[82%] sm:w-[60%] md:w-auto flex-shrink-0 md:flex-shrink snap-center md:snap-align-none">
          <ImageCard
            title="progirls"
            description="our initiative supporting women in tech. open to everyone, at every stage of the journey. building a more inclusive community in the tech space."
            ctaText="learn more"
            ctaHref="/progirls"
            imageSrc="/images/landing%20page/progirls.jpg"
            imageAlt="participants at a progirls program event"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- About Section (intro + mission/team cards) -->
  <section id="our-mission" class="pt-16 pb-8 px-8 bg-transparent relative overflow-hidden">
    <div class="max-w-5xl mx-auto relative z-10 float-in">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 tracking-widest italic" style="font-family: 'Helvetica Neue', sans-serif;">
          about
        </h2>
        <p class="text-lg md:text-xl text-white/60 leading-relaxed font-light" style="font-family: 'Helvetica Neue', sans-serif;">
          <span class="text-white" style="text-shadow: 0 0 20px rgba(255,255,255,0.3), 0 0 40px rgba(255,255,255,0.1);">a builder collective</span> born in atlanta. for people drawn to code, creation, and culture. a place to turn curiosity into craft, and ideas into things that live in the world.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <ImageCard
          title="our mission"
          description="we exist so no builder in atlanta has to figure it out alone. real projects, real mentorship, and a community that ships together."
          ctaText="read our story"
          ctaHref="/history"
          imageSrc="/images/landing%20page/our%20mission.jpg"
          imageAlt="progsu members building together"
          imageAspect="aspect-[3/2]"
        />

        <ImageCard
          title="meet the team"
          description="the students and organizers behind progsu's events, movements, and community."
          ctaText="meet the team"
          ctaHref="/members"
          imageSrc="/images/landing%20page/meet%20the%20team.jpg"
          imageAlt="the progsu team"
          imageAspect="aspect-[3/2]"
        />
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="bg-black py-2 overflow-hidden" aria-hidden="true">
    <div class="divider-shift">
      <div class="divider-float">
        <img
          src="/images/landing%20page/hands-divider.png"
          alt=""
          class="w-full opacity-80"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <!-- Get Involved Section -->
  <section id="get-involved" class="pt-10 pb-24 px-8 bg-black">
    <div class="max-w-4xl mx-auto text-center float-in">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 tracking-widest italic" style="font-family: 'Helvetica Neue', sans-serif;">
        get involved
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 max-w-2xl mx-auto">
        <!-- Students -->
        <div class="space-y-6">
          <h3 class="text-xl font-bold text-white italic" style="font-family: 'Noto Serif', Georgia, serif !important;">for students</h3>
          <p class="text-white/50 leading-relaxed" style="font-family: 'Helvetica Neue', sans-serif;">
            join 1500+ creators, innovators, and builders shaping the future from atlanta.
          </p>
          <a
            href="https://progsu-platform.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-white border-b border-white/30 hover:border-white pb-1 text-sm tracking-widest transition-colors duration-300"
            style="font-family: 'Helvetica Neue', sans-serif;"
          >
            join progsu &rarr;
          </a>
        </div>

        <!-- Partners -->
        <div class="space-y-6">
          <h3 class="text-xl font-bold text-white italic" style="font-family: 'Noto Serif', Georgia, serif !important;">for partners</h3>
          <p class="text-white/50 leading-relaxed" style="font-family: 'Helvetica Neue', sans-serif;">
            connect with atlanta's largest student tech talent pipeline. sponsor, recruit, co-create.
          </p>
          <a
            href="/contact"
            class="inline-block text-white border-b border-white/30 hover:border-white pb-1 text-sm tracking-widest transition-colors duration-300"
            style="font-family: 'Helvetica Neue', sans-serif;"
          >
            start a partnership &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Connect Section -->
  <section id="contact" class="py-24 px-8 bg-black">
    <div class="max-w-3xl mx-auto text-center float-in">
      <div class="flex justify-center items-center gap-10 md:gap-16">
        <a href={DISCORD_LINK} target="_blank" rel="noopener noreferrer" class="text-white/45 hover:text-white text-sm tracking-widest transition-all duration-300" style="font-family: 'Helvetica Neue', sans-serif; text-shadow: 0 0 8px rgba(147, 51, 234, 0);" onmouseover="this.style.textShadow='0 0 12px rgba(147,51,234,1), 0 0 30px rgba(147,51,234,0.6), 0 0 60px rgba(147,51,234,0.25)'" onmouseout="this.style.textShadow='0 0 8px rgba(147,51,234,0)'">discord</a>
        <a href={INSTAGRAM_LINK} target="_blank" rel="noopener noreferrer" class="text-white/45 hover:text-white text-sm tracking-widest transition-all duration-300" style="font-family: 'Helvetica Neue', sans-serif; text-shadow: 0 0 8px rgba(147, 51, 234, 0);" onmouseover="this.style.textShadow='0 0 12px rgba(147,51,234,1), 0 0 30px rgba(147,51,234,0.6), 0 0 60px rgba(147,51,234,0.25)'" onmouseout="this.style.textShadow='0 0 8px rgba(147,51,234,0)'">instagram</a>
        <a href={LINKEDIN_LINK} target="_blank" rel="noopener noreferrer" class="text-white/45 hover:text-white text-sm tracking-widest transition-all duration-300" style="font-family: 'Helvetica Neue', sans-serif; text-shadow: 0 0 8px rgba(147, 51, 234, 0);" onmouseover="this.style.textShadow='0 0 12px rgba(147,51,234,1), 0 0 30px rgba(147,51,234,0.6), 0 0 60px rgba(147,51,234,0.25)'" onmouseout="this.style.textShadow='0 0 8px rgba(147,51,234,0)'">linkedin</a>
        <a href={EMAIL_LINK} class="text-white/45 hover:text-white text-sm tracking-widest transition-all duration-300" style="font-family: 'Helvetica Neue', sans-serif; text-shadow: 0 0 8px rgba(147, 51, 234, 0);" onmouseover="this.style.textShadow='0 0 12px rgba(147,51,234,1), 0 0 30px rgba(147,51,234,0.6), 0 0 60px rgba(147,51,234,0.25)'" onmouseout="this.style.textShadow='0 0 8px rgba(147,51,234,0)'">email</a>
      </div>
      <p class="text-white/50 text-xs mt-12 tracking-widest" style="font-family: 'Helvetica Neue', sans-serif;">
        &copy; 2026 progsu
      </p>
    </div>
  </section>

<style>
  .float-in {
    opacity: 0;
    transform: translateY(40px);
    filter: blur(10px);
    transition: opacity 0.9s ease-out, transform 0.9s ease-out, filter 0.9s ease-out;
  }

  .float-in.visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .divider-shift {
    transform: translateX(-6%);
  }

  .divider-float {
    animation:
      divider-bob 4.6s ease-in-out infinite,
      divider-wobble 6.2s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes divider-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes divider-wobble {
    0%, 100% { transform: rotate(-3.5deg); }
    50% { transform: rotate(3.5deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .divider-float { animation: none; }
  }
</style>

<script>
  function initFloatIn() {
    const elements = document.querySelectorAll('.float-in');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.01 });

    elements.forEach((el) => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatIn);
  } else {
    initFloatIn();
  }
  document.addEventListener('astro:page-load', initFloatIn);
</script>

</Layout>
