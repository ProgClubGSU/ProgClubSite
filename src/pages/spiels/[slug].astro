---
import Layout from "@/layouts/Layout.astro";
import CanvaEmbed from "@/components/spiels/CanvaEmbed.astro";
import { SPIELS, formatSpielDate, type Spiel } from "@/spiels";

export function getStaticPaths() {
  return SPIELS.map((spiel) => ({
    params: { slug: spiel.slug },
    props: { spiel },
  }));
}

type Props = { spiel: Spiel };

const { spiel } = Astro.props;
const formattedDate = formatSpielDate(spiel.date);
---

<Layout title={spiel.title} description={spiel.description}>
  <div class="max-w-5xl mx-auto px-4 pt-24 pb-16">
    <nav
      class="flex items-center gap-2 text-white/80 text-sm mb-8"
      aria-label="Breadcrumb"
    >
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/spiels" class="hover:underline">Spiels</a>
      <span>/</span>
      <span class="text-white">{spiel.title}</span>
    </nav>

    <div class="mb-8">
      <h1
        class="text-3xl md:text-5xl font-bold text-white mb-3 leading-tight break-words"
      >
        {spiel.title}
      </h1>
      <p class="text-white/60 text-sm">{formattedDate}</p>
      {
        spiel.description && (
          <p class="text-white/80 text-lg leading-relaxed mt-4 max-w-3xl">
            {spiel.description}
          </p>
        )
      }
    </div>

    <CanvaEmbed title={spiel.title} canvaUrl={spiel.canvaUrl} />

    <div class="flex flex-wrap items-center gap-3 mt-4">
      <button
        type="button"
        data-spiel-fullscreen
        class="px-5 py-2.5 rounded-lg font-medium transition-colors duration-300 border bg-white/10 hover:bg-white/20 border-white/20 text-white"
      >
        Full screen
      </button>
      <button
        type="button"
        data-spiel-restart
        class="px-5 py-2.5 rounded-lg font-medium transition-colors duration-300 border bg-white/10 hover:bg-white/20 border-white/20 text-white"
      >
        Restart deck
      </button>
      <a
        href={`/spiels/${spiel.slug}/present`}
        data-astro-reload
        class="px-5 py-2.5 rounded-lg font-medium transition-colors duration-300 border bg-purple-600/40 hover:bg-purple-600/60 border-purple-400/50 text-white"
      >
        Present
      </a>
    </div>

    <p class="text-white/50 text-sm mt-4">
      Restart deck reloads the slides from the first one if Canva's own controls
      go away at the end.
    </p>
  </div>

  <script is:inline>
    (function () {
      function init() {
        var frame = document.querySelector(".canva-embed__frame");
        var iframe = document.querySelector("[data-canva-frame]");
        var fsButton = document.querySelector("[data-spiel-fullscreen]");
        var restartButton = document.querySelector("[data-spiel-restart]");
        if (!frame || !iframe) return;

        if (fsButton && !fsButton.dataset.bound) {
          fsButton.dataset.bound = "1";
          fsButton.addEventListener("click", function () {
            var request =
              frame.requestFullscreen ||
              frame.webkitRequestFullscreen ||
              frame.webkitRequestFullScreen ||
              frame.msRequestFullscreen;
            if (request) request.call(frame);
          });
        }

        if (restartButton && !restartButton.dataset.bound) {
          restartButton.dataset.bound = "1";
          restartButton.addEventListener("click", function () {
            iframe.src = iframe.src;
          });
        }
      }
      init();
      document.addEventListener("astro:page-load", init);
    })();
  </script>
</Layout>
