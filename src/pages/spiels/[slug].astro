---
import Layout from "@/layouts/Layout.astro";
import CanvaEmbed from "@/components/spiels/CanvaEmbed.astro";
import { SPIELS, formatSpielDate, type Spiel } from "@/spiels";

export function getStaticPaths() {
  return SPIELS.map((spiel) => ({
    params: { slug: spiel.slug },
    props: { spiel },
  }));
}

type Props = { spiel: Spiel };

const { spiel } = Astro.props;
const formattedDate = formatSpielDate(spiel.date);
---

<Layout title={spiel.title} description={spiel.description}>
  <div class="max-w-5xl mx-auto px-4 pt-24 pb-16">
    <nav
      class="flex items-center gap-2 text-white/80 text-sm mb-8"
      aria-label="Breadcrumb"
    >
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/spiels" class="hover:underline">Spiels</a>
      <span>/</span>
      <span class="text-white">{spiel.title}</span>
    </nav>

    <div class="mb-8">
      <h1
        class="text-3xl md:text-5xl font-bold text-white mb-3 leading-tight break-words"
      >
        {spiel.title}
      </h1>
      <p class="text-white/60 text-sm">{formattedDate}</p>
      {
        spiel.description && (
          <p class="text-white/80 text-lg leading-relaxed mt-4 max-w-3xl">
            {spiel.description}
          </p>
        )
      }
    </div>

    <div class="relative">
      <CanvaEmbed title={spiel.title} canvaUrl={spiel.canvaUrl} />

      <div class="deck-menu" id="deck-menu">
        <button
          type="button"
          class="deck-menu__handle"
          id="deck-menu-handle"
          aria-expanded="false"
          aria-controls="deck-menu-items"
          aria-label="Deck controls"
        >
          <span aria-hidden="true">&#8942;</span>
        </button>
        <div class="deck-menu__items" id="deck-menu-items" hidden>
          <button type="button" id="deck-fullscreen">Full screen</button>
          <button type="button" id="deck-restart">Restart</button>
          <a href={`/spiels/${spiel.slug}/present`} data-astro-reload>Present</a
          >
        </div>
      </div>
    </div>

    <p class="text-white/60 text-sm mt-4">
      Running this in front of a room?{" "}
      <a
        href={`/spiels/${spiel.slug}/present`}
        data-astro-reload
        class="text-purple-300 hover:text-purple-200 underline underline-offset-4"
      >
        Present full screen
      </a>
    </p>
  </div>

  <script is:inline>
    (function () {
      function init() {
        var frame = document.querySelector(".canva-embed__frame");
        var iframe = document.querySelector("[data-canva-frame]");
        var menu = document.getElementById("deck-menu");
        var handle = document.getElementById("deck-menu-handle");
        var items = document.getElementById("deck-menu-items");
        var fsButton = document.getElementById("deck-fullscreen");
        var restartButton = document.getElementById("deck-restart");
        if (!frame || !iframe || !menu || !handle || !items) return;
        if (menu.dataset.bound) return;
        menu.dataset.bound = "1";

        function setOpen(open) {
          items.hidden = !open;
          handle.setAttribute("aria-expanded", open ? "true" : "false");
          menu.classList.toggle("is-open", open);
        }

        handle.addEventListener("click", function () {
          setOpen(items.hidden);
        });

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") setOpen(false);
        });

        document.addEventListener("click", function (event) {
          if (!menu.contains(event.target)) setOpen(false);
        });

        if (fsButton) {
          fsButton.addEventListener("click", function () {
            var request =
              frame.requestFullscreen ||
              frame.webkitRequestFullscreen ||
              frame.webkitRequestFullScreen ||
              frame.msRequestFullscreen;
            if (request) request.call(frame);
            setOpen(false);
          });
        }

        if (restartButton) {
          restartButton.addEventListener("click", function () {
            iframe.src = iframe.src;
            setOpen(false);
          });
        }
      }
      init();
      document.addEventListener("astro:page-load", init);
    })();
  </script>

  <style>
    .deck-menu {
      position: absolute;
      left: 0.75rem;
      top: 0.75rem;
      z-index: 30;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .deck-menu__handle {
      width: 2rem;
      height: 2.5rem;
      display: grid;
      place-items: center;
      border-radius: 0.5rem;
      border: 1px solid rgb(255 255 255 / 0.2);
      background: rgb(255 255 255 / 0.1);
      color: rgb(255 255 255 / 0.85);
      font-size: 1.125rem;
      line-height: 1;
      cursor: pointer;
      opacity: 0.7;
      backdrop-filter: blur(4px);
      transition:
        opacity 0.2s ease,
        background-color 0.2s ease;
    }

    .deck-menu__handle:hover,
    .deck-menu__handle:focus-visible,
    .deck-menu.is-open .deck-menu__handle {
      opacity: 1;
      background: rgb(255 255 255 / 0.12);
      color: #fff;
    }

    .deck-menu__items {
      display: flex;
      flex-direction: column;
      min-width: 10rem;
      padding: 0.375rem;
      gap: 0.125rem;
      border-radius: 0.5rem;
      border: 1px solid rgb(255 255 255 / 0.15);
      background: rgb(10 10 10 / 0.9);
      backdrop-filter: blur(8px);
    }

    .deck-menu__items[hidden] {
      display: none;
    }

    .deck-menu__items button,
    .deck-menu__items a {
      display: block;
      width: 100%;
      text-align: left;
      padding: 0.5rem 0.75rem;
      border: 0;
      border-radius: 0.375rem;
      background: transparent;
      color: rgb(255 255 255 / 0.85);
      font-size: 0.875rem;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .deck-menu__items button:hover,
    .deck-menu__items a:hover {
      background: rgb(255 255 255 / 0.12);
      color: #fff;
    }
  </style>
</Layout>
