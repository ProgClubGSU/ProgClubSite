---
import CanvaEmbed from "@/components/spiels/CanvaEmbed.astro";
import { SPIELS, type Spiel } from "@/spiels";
import "@/styles/global.css";

export function getStaticPaths() {
  return SPIELS.map((spiel) => ({
    params: { slug: spiel.slug },
    props: { spiel },
  }));
}

type Props = { spiel: Spiel };

const { spiel } = Astro.props;
---

<html lang="en" class="spiel-present">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href="/lighthouse.png" />
    <title>{spiel.title}</title>
  </head>
  <body>
    <div class="stage" id="stage">
      <CanvaEmbed
        title={spiel.title}
        canvaUrl={spiel.canvaUrl}
        variant="fill"
      />

      <!-- Sits above the iframe, which swallows pointer events, so the
           controls stay reachable no matter what slide Canva is on. -->
      <div class="menu" id="menu">
        <button
          type="button"
          class="menu__handle"
          id="menu-handle"
          aria-expanded="false"
          aria-controls="menu-items"
          aria-label="Controls"
        >
          <span aria-hidden="true">&#8942;</span>
        </button>
        <div class="menu__items" id="menu-items" hidden>
          <button type="button" id="fs-button">Enter full screen</button>
          <button type="button" id="restart-button">Restart</button>
          <a href={`/spiels/${spiel.slug}`} data-astro-reload>Exit</a>
        </div>
      </div>

      <div class="rotate-hint" id="rotate-hint" hidden>
        <p>Turn your phone sideways for a bigger view.</p>
        <button type="button" id="rotate-dismiss">Got it</button>
      </div>
    </div>

    <script is:inline>
      (function () {
        var stage = document.getElementById("stage");
        var menu = document.getElementById("menu");
        var handle = document.getElementById("menu-handle");
        var items = document.getElementById("menu-items");
        var fsButton = document.getElementById("fs-button");
        var restartButton = document.getElementById("restart-button");
        var iframe = document.querySelector("[data-canva-frame]");
        var hint = document.getElementById("rotate-hint");
        var dismiss = document.getElementById("rotate-dismiss");
        if (!stage || !menu || !handle || !items || !fsButton) return;

        function fullscreenElement() {
          return (
            document.fullscreenElement ||
            document.webkitFullscreenElement ||
            document.msFullscreenElement ||
            null
          );
        }

        function requestFullscreen(el) {
          var fn =
            el.requestFullscreen ||
            el.webkitRequestFullscreen ||
            el.webkitRequestFullScreen ||
            el.msRequestFullscreen;
          if (fn) fn.call(el);
        }

        function exitFullscreen() {
          var fn =
            document.exitFullscreen ||
            document.webkitExitFullscreen ||
            document.msExitFullscreen;
          if (fn) fn.call(document);
        }

        function setOpen(open) {
          items.hidden = !open;
          handle.setAttribute("aria-expanded", open ? "true" : "false");
          menu.classList.toggle("is-open", open);
        }

        function syncFsButton() {
          fsButton.textContent = fullscreenElement()
            ? "Exit full screen"
            : "Enter full screen";
        }

        handle.addEventListener("click", function () {
          setOpen(items.hidden);
        });

        fsButton.addEventListener("click", function () {
          if (fullscreenElement()) {
            exitFullscreen();
          } else {
            requestFullscreen(stage);
          }
          setOpen(false);
        });

        if (restartButton && iframe) {
          restartButton.addEventListener("click", function () {
            iframe.src = iframe.src;
            setOpen(false);
          });
        }

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") setOpen(false);
        });

        document.addEventListener("click", function (event) {
          if (!menu.contains(event.target)) setOpen(false);
        });

        [
          "fullscreenchange",
          "webkitfullscreenchange",
          "MSFullscreenChange",
        ].forEach(function (type) {
          document.addEventListener(type, syncFsButton);
        });

        syncFsButton();

        if (hint && dismiss) {
          var STORAGE_KEY = "spiel-rotate-hint-dismissed";
          var dismissed = false;
          try {
            dismissed = sessionStorage.getItem(STORAGE_KEY) === "1";
          } catch (error) {
            dismissed = false;
          }
          if (!dismissed) hint.hidden = false;

          dismiss.addEventListener("click", function () {
            hint.hidden = true;
            try {
              sessionStorage.setItem(STORAGE_KEY, "1");
            } catch (error) {
              /* sessionStorage unavailable, hint returns next load */
            }
          });
        }
      })();
    </script>

    <style is:global>
      /* Scoped to this page by class: CSS is bundled site-wide (cssCodeSplit is off) */
      html.spiel-present,
      html.spiel-present body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #000;
        color: #fff;
        overflow: hidden;
        font-family: "Helvetica Neue", "Helvetica", "Arial", sans-serif;
      }
    </style>

    <style>
      .stage {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        --spiel-viewport-height: 100dvh;
      }

      .stage:fullscreen {
        --spiel-viewport-height: 100vh;
      }

      .menu {
        position: absolute;
        left: max(0.75rem, env(safe-area-inset-left));
        top: max(0.75rem, env(safe-area-inset-top));
        z-index: 30;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .menu__handle {
        width: 2rem;
        height: 2.5rem;
        display: grid;
        place-items: center;
        border-radius: 0.5rem;
        border: 1px solid rgb(255 255 255 / 0.12);
        background: rgb(255 255 255 / 0.06);
        color: rgb(255 255 255 / 0.6);
        font-size: 1.125rem;
        line-height: 1;
        cursor: pointer;
        opacity: 0.35;
        backdrop-filter: blur(4px);
        transition:
          opacity 0.2s ease,
          background-color 0.2s ease;
      }

      .menu__handle:hover,
      .menu__handle:focus-visible,
      .menu.is-open .menu__handle {
        opacity: 1;
        background: rgb(255 255 255 / 0.12);
        color: #fff;
      }

      .menu__items {
        display: flex;
        flex-direction: column;
        min-width: 10rem;
        padding: 0.375rem;
        gap: 0.125rem;
        border-radius: 0.5rem;
        border: 1px solid rgb(255 255 255 / 0.15);
        background: rgb(10 10 10 / 0.9);
        backdrop-filter: blur(8px);
      }

      .menu__items[hidden] {
        display: none;
      }

      .menu__items button,
      .menu__items a {
        display: block;
        width: 100%;
        text-align: left;
        padding: 0.5rem 0.75rem;
        border: 0;
        border-radius: 0.375rem;
        background: transparent;
        color: rgb(255 255 255 / 0.85);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .menu__items button:hover,
      .menu__items a:hover {
        background: rgb(255 255 255 / 0.12);
        color: #fff;
      }

      .rotate-hint {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        bottom: max(1rem, env(safe-area-inset-bottom));
        z-index: 20;
        display: none;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 1rem;
        border-radius: 0.5rem;
        border: 1px solid rgb(255 255 255 / 0.1);
        background: rgb(255 255 255 / 0.05);
        backdrop-filter: blur(4px);
      }

      .rotate-hint p {
        margin: 0;
        font-size: 0.8125rem;
        color: rgb(255 255 255 / 0.8);
      }

      .rotate-hint button {
        border: 1px solid rgb(255 255 255 / 0.2);
        background: transparent;
        color: #fff;
        border-radius: 0.375rem;
        padding: 0.25rem 0.625rem;
        font-size: 0.75rem;
        cursor: pointer;
      }

      .rotate-hint[hidden] {
        display: none;
      }

      @media (max-width: 767px) and (orientation: portrait) {
        .rotate-hint:not([hidden]) {
          display: flex;
        }
      }
    </style>
  </body>
</html>
